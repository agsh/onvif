# Keep the published tarball limited to runtime artifacts + package metadata.
# Included (not listed here): build/, package.json, LICENSE, README.md

# VCS / CI / IDE
.git/
.github/
.idea/
*.iml
.gitignore
.gitattributes

# Dependencies & local artifacts
node_modules/
coverage/
.nyc_output/
logs/
*.log
*.cfg
*.tsbuildinfo
*.tgz

# Local notes / scratch
FORWARD
interfacesCleanup.ts

# Legacy v0.x typings (v1 types live in build/)
/index.d.ts

# Sources (consumers use build/)
src/

# Docs site, internal docs & examples
docs/
innerDocs/
examples/

# Tests
__tests__/
__test__/
cam_tests/
experiments/
test/
test.*

# Tooling configs
.npmignore
.mocharc.js
.prettierignore
.prettierrc
eslint.config.mjs
jest.config.js
tsconfig.json
typedoc.json
package-lock.json

# Dev-only markdown (README.md stays published)
CHANGELOG.md
CONTRIBUTING.md
